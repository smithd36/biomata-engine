// Biomata.SDK — GrpcTransport.cs
//
// ITransport implementation that adapts the existing Biomata.Proto gRPC stub.
// Kept available for research / server integrations where users explicitly
// opt into gRPC via BiomataConfig.Transport.Grpc.
//
// On Unity, prefer WebSocketTransport — it compiles cleanly on Unity 6 without
// the SocketsHttpHandler reference-assembly issue and works inside WebGL.

using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Threading;
using System.Threading.Tasks;
using Biomata.Proto;
using Biomata.SDK.Models;
using Google.Protobuf;
using Grpc.Core;
using Grpc.Net.Client;
using static Biomata.Proto.SimulationService;

namespace Biomata.SDK.Transport
{
    /// <summary>
    /// gRPC-based ITransport. Wraps the proto-generated SimulationServiceClient.
    ///
    /// This class consolidates every proto-conversion path so the sub-clients
    /// stay transport-agnostic. The bulk of the code mirrors the original
    /// gRPC sub-client logic prior to the transport refactor.
    /// </summary>
    internal sealed class GrpcTransport : ITransport
    {
        private readonly BiomataConfig _config;
        private GrpcChannel             _channel;
        private SimulationServiceClient _stub;

        // Event-stream background task and its cancellation token.
        private CancellationTokenSource _eventCts;
        private Task                    _eventLoop;
        private HashSet<string>         _eventFilter;

        public ConnectionState State { get; private set; } = ConnectionState.Disconnected;
        public bool            IsConnected => State == ConnectionState.Connected;
        public event Action<ConnectionState> OnStateChanged;
        public event Action<SimulationEvent> OnEvent;
        public event Action<Exception>       OnEventStreamDisconnected;

        public GrpcTransport(BiomataConfig config)
        {
            _config = config ?? throw new ArgumentNullException(nameof(config));
        }

        // ── Lifecycle ────────────────────────────────────────────────────────

        public Task ConnectAsync(CancellationToken ct = default)
        {
            if (State == ConnectionState.Connected)
                throw new InvalidOperationException("Already connected. Call DisconnectAsync() first.");

            SetState(ConnectionState.Connecting);
            try
            {
                if (!_config.UseTls)
                {
                    AppContext.SetSwitch(
                        "System.Net.Http.SocketsHttpHandler.Http2UnencryptedSupport", true);
                }

                var opts    = new GrpcChannelOptions();
                var handler = BuildHttpHandler();
                if (handler != null) opts.HttpHandler = handler;

                _channel = GrpcChannel.ForAddress(_config.Address, opts);
                _stub    = new SimulationServiceClient(_channel);
                SetState(ConnectionState.Connected);
                return Task.CompletedTask;
            }
            catch (Exception ex)
            {
                SetState(ConnectionState.Faulted);
                throw new BiomataException($"gRPC connect to {_config.Address} failed: {ex.Message}", ex);
            }
        }

        public async Task DisconnectAsync()
        {
            if (State == ConnectionState.Disconnected || State == ConnectionState.Disconnecting)
                return;
            SetState(ConnectionState.Disconnecting);
            await UnsubscribeEventsAsync();
            if (_channel != null)
            {
                try { await _channel.ShutdownAsync(); } catch { /* ignore */ }
                _channel.Dispose();
                _channel = null;
                _stub    = null;
            }
            SetState(ConnectionState.Disconnected);
        }

        public async ValueTask DisposeAsync()
        {
            await DisconnectAsync();
        }

        // ── RPCs ─────────────────────────────────────────────────────────────

        public async Task<HealthStatus> HealthCheckAsync(CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var resp = await _stub.HealthCheckAsync(new HealthCheckRequest(), BuildCallOptions(ct));
                return new HealthStatus
                {
                    Status       = resp.Status,
                    SessionState = resp.SessionState,
                    Tick         = resp.Tick,
                    AgentCount   = resp.AgentCount,
                };
            }
            catch (RpcException ex) { throw new BiomataException("HealthCheck failed", ex); }
        }

        public async Task RegisterAgentAsync(AgentRegistration reg, CancellationToken ct = default)
        {
            EnsureConnected();
            if (reg == null) throw new ArgumentNullException(nameof(reg));

            var cfg = new AgentConfig
            {
                AgentId    = reg.AgentId,
                AgentName  = reg.AgentName ?? reg.AgentId,
                BrainClass = reg.BrainClass,
            };
            if (reg.BrainConfig  != null) cfg.BrainConfig  = ProtoUtils.ToStruct(reg.BrainConfig);
            if (!string.IsNullOrEmpty(reg.MemoryClass)) cfg.MemoryClass = reg.MemoryClass;
            if (reg.MemoryConfig != null) cfg.MemoryConfig = ProtoUtils.ToStruct(reg.MemoryConfig);

            try
            {
                var resp = await _stub.RegisterAgentAsync(
                    new RegisterAgentRequest { Config = cfg }, BuildCallOptions(ct));
                BiomataException.ThrowIfFailed(resp.Success, resp.Error, $"RegisterAgent({reg.AgentId})");
            }
            catch (BiomataException) { throw; }
            catch (RpcException ex) { throw new BiomataException($"RegisterAgent({reg.AgentId}) transport error", ex); }
        }

        public async Task RemoveAgentAsync(string agentId, CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var resp = await _stub.RemoveAgentAsync(
                    new RemoveAgentRequest { AgentId = agentId }, BuildCallOptions(ct));
                BiomataException.ThrowIfFailed(resp.Success, resp.Error, $"RemoveAgent({agentId})");
            }
            catch (BiomataException) { throw; }
            catch (RpcException ex) { throw new BiomataException($"RemoveAgent({agentId}) transport error", ex); }
        }

        public async Task SendObservationAsync(string agentId, Dictionary<string, object> observation, CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var resp = await _stub.SendObservationAsync(
                    new SendObservationRequest
                    {
                        AgentId     = agentId,
                        Observation = ProtoUtils.ToStruct(observation),
                    },
                    BuildCallOptions(ct));
                BiomataException.ThrowIfFailed(resp.Success, resp.Error, $"SendObservation({agentId})");
            }
            catch (BiomataException) { throw; }
            catch (RpcException ex) { throw new BiomataException($"SendObservation({agentId}) transport error", ex); }
        }

        public async Task<TickResult> TickAsync(
            IEnumerable<AgentObservationData> observations,
            Dictionary<string, object>        metadata,
            CancellationToken                 ct = default)
        {
            EnsureConnected();
            var req = new TickRequest();
            if (observations != null)
            {
                foreach (var o in observations)
                {
                    if (string.IsNullOrEmpty(o?.AgentId)) continue;
                    req.AgentObservations.Add(new AgentObservation
                    {
                        AgentId     = o.AgentId,
                        Observation = ProtoUtils.ToStruct(o.Observation),
                    });
                }
            }
            if (metadata != null) req.WorldMetadata = ProtoUtils.ToStruct(metadata);

            try
            {
                var resp = await _stub.TickSimulationAsync(req, BuildCallOptions(ct));
                return new TickResult(resp);
            }
            catch (RpcException ex) when (ex.StatusCode == StatusCode.FailedPrecondition)
            {
                throw new BiomataException($"TickSimulation: invalid session state — {ex.Status.Detail}", ex);
            }
            catch (RpcException ex) { throw new BiomataException("TickSimulation transport error", ex); }
        }

        public async Task<string> PauseAsync(CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var r = await _stub.PauseSimulationAsync(new PauseRequest(), BuildCallOptions(ct));
                return r.State ?? string.Empty;
            }
            catch (RpcException ex) { throw new BiomataException("PauseSimulation transport error", ex); }
        }

        public async Task<string> ResumeAsync(CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var r = await _stub.ResumeSimulationAsync(new ResumeRequest(), BuildCallOptions(ct));
                return r.State ?? string.Empty;
            }
            catch (RpcException ex) { throw new BiomataException("ResumeSimulation transport error", ex); }
        }

        public async Task<SnapshotData> SnapshotAsync(CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var resp = await _stub.SnapshotAsync(new SnapshotRequest(), BuildCallOptions(ct));
                return new SnapshotData
                {
                    Data      = resp.SnapshotData.ToByteArray(),
                    Tick      = resp.Tick,
                    CreatedAt = resp.CreatedAt,
                };
            }
            catch (RpcException ex) { throw new BiomataException("Snapshot capture failed", ex); }
        }

        public async Task<int> RestoreAsync(byte[] snapshotData, CancellationToken ct = default)
        {
            EnsureConnected();
            try
            {
                var resp = await _stub.RestoreAsync(
                    new RestoreRequest { SnapshotData = ByteString.CopyFrom(snapshotData) },
                    BuildCallOptions(ct));
                BiomataException.ThrowIfFailed(resp.Success, resp.Error, "Restore");
                return resp.Tick;
            }
            catch (BiomataException) { throw; }
            catch (RpcException ex) { throw new BiomataException("Restore transport error", ex); }
        }

        // ── Event stream ─────────────────────────────────────────────────────

        public Task SubscribeEventsAsync(IEnumerable<string> eventTypeFilter, CancellationToken ct = default)
        {
            EnsureConnected();
            _eventFilter = eventTypeFilter != null ? new HashSet<string>(eventTypeFilter) : null;

            if (_eventLoop != null && !_eventLoop.IsCompleted)
                return Task.CompletedTask;   // already running — filter update only

            _eventCts  = new CancellationTokenSource();
            _eventLoop = StreamEventsAsync(_eventCts.Token);
            return Task.CompletedTask;
        }

        public async Task UnsubscribeEventsAsync(CancellationToken ct = default)
        {
            _eventCts?.Cancel();
            if (_eventLoop != null)
            {
                try { await _eventLoop; }
                catch { /* ignore */ }
                _eventLoop = null;
            }
            _eventCts?.Dispose();
            _eventCts = null;
        }

        private async Task StreamEventsAsync(CancellationToken ct)
        {
            Exception fault = null;
            try
            {
                var req = new StreamEventsRequest();
                // Server-side filter ↔ client-side filter: send the filter so
                // the server doesn't ship events we'll discard.
                if (_eventFilter != null)
                    foreach (var t in _eventFilter)
                        if (!string.IsNullOrEmpty(t)) req.EventTypes.Add(t);

                using var call = _stub.StreamEvents(req, cancellationToken: ct);
                while (await call.ResponseStream.MoveNext(ct))
                {
                    var proto = call.ResponseStream.Current;
                    if (_eventFilter != null && !_eventFilter.Contains(proto.EventType)) continue;
                    OnEvent?.Invoke(new SimulationEvent(proto));
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
            catch (Exception ex) { fault = ex; }
            finally { OnEventStreamDisconnected?.Invoke(fault); }
        }

        // ── Helpers ──────────────────────────────────────────────────────────

        private void EnsureConnected()
        {
            if (!IsConnected) throw new BiomataException("Transport is not connected. Call ConnectAsync() first.");
        }

        private CallOptions BuildCallOptions(CancellationToken ct)
        {
            var timeout = _config.DefaultCallTimeout;
            var deadline = timeout > TimeSpan.Zero ? (DateTime?)DateTime.UtcNow + timeout : null;
            return new CallOptions(cancellationToken: ct, deadline: deadline);
        }

        private static HttpMessageHandler BuildHttpHandler()
        {
            // Same reflection trick as SimulationClient — SocketsHttpHandler
            // isn't in Unity 6's .NET Standard 2.1 reference assemblies, but
            // it is in Mono's actual runtime on Editor/Standalone.
            var sockets = Type.GetType("System.Net.Http.SocketsHttpHandler, System.Net.Http", throwOnError: false)
                       ?? Type.GetType("System.Net.Http.SocketsHttpHandler", throwOnError: false);
            if (sockets == null) return null;
            try
            {
                var handler = Activator.CreateInstance(sockets);
                TrySet(sockets, handler, "PooledConnectionIdleTimeout",    TimeSpan.FromMinutes(5));
                TrySet(sockets, handler, "KeepAlivePingDelay",             TimeSpan.FromSeconds(60));
                TrySet(sockets, handler, "KeepAlivePingTimeout",           TimeSpan.FromSeconds(30));
                TrySet(sockets, handler, "EnableMultipleHttp2Connections", true);
                return (HttpMessageHandler)handler;
            }
            catch { return null; }
        }

        private static void TrySet(Type t, object instance, string prop, object value)
        {
            try
            {
                var pi = t.GetProperty(prop);
                if (pi != null && pi.CanWrite) pi.SetValue(instance, value);
            }
            catch { /* ignore */ }
        }

        private void SetState(ConnectionState s)
        {
            if (State == s) return;
            State = s;
            OnStateChanged?.Invoke(s);
        }
    }
}
