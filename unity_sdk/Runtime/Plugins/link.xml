<!--
  link.xml — prevents IL2CPP managed-code stripping from removing types the
  SDK accesses at runtime.

  Editor and Play Mode are unaffected (stripping is build-time only).
-->
<linker>
  <!-- JSON transport layer -->
  <assembly fullname="Newtonsoft.Json" preserve="all"/>

  <!-- WebSocket types used by WebSocketTransport -->
  <assembly fullname="System.Net.WebSockets">
    <type fullname="System.Net.WebSockets.ClientWebSocket"       preserve="all"/>
    <type fullname="System.Net.WebSockets.WebSocketReceiveResult" preserve="all"/>
  </assembly>
</linker>
